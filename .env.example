# Copy this file to .env and fill it in. Never commit .env.

# Database. Local Postgres (docker compose or a native install):
DATABASE_URL=postgresql://allfix:allfix@localhost:5432/allfix
# Or Supabase (Project settings > Database > Connection string, "Session pooler"):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# How the strategist reaches Claude.
#   subscription (default): your own Claude plan. Run `claude login` once on this PC. No API key, no API billing.
#                           For your own use only; it refuses requests from other machines.
#   api: the Claude API, billed per use. Needs ANTHROPIC_API_KEY.
STRATEGIST_BACKEND=subscription
# ANTHROPIC_API_KEY=

# Models. Change here without touching code.
MODEL_STANDARD=claude-opus-5-5
MODEL_DEEP=claude-opus-5-5
EFFORT_STANDARD=high
EFFORT_DEEP=max
MAX_TOOL_CALLS_PER_TURN=60

# Stage 01 and Google Ads (read-only). See docs/GOOGLE_ADS_SETUP.md.
# PIACTL_PATH=C:\Program Files\Private Internet Access\piactl.exe
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# ADS_REFRESH_TOKEN=          (written by `python -m allfix ads-login --country US`)
# DOLPHIN_API_TOKEN=

# Web server. Keep 127.0.0.1 on your PC. Set a password before exposing it anywhere else.
HOST=127.0.0.1
PORT=8000
# ALLFIX_PASSWORD=
